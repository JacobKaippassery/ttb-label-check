# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Run without an API key, using stored transcriptions of the sample labels.
# The whole UI, rules engine, batch streaming and CSV export work in this mode.
# Results are clearly badged as demo data and no API calls are made.
# This is opt-in only — it is never used as a silent fallback for a failed call.
DEMO_MODE=false

# Model used for label extraction.
#   claude-opus-5     - highest accuracy (default)
#   claude-sonnet-5   - faster, still strong on vision
#   claude-haiku-4-5  - fastest / cheapest, best for high-volume batch
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# "low" is the right default here: extraction is perception, not reasoning,
# and the compliance decisions are made by deterministic code, not the model.
# Ignored by models that do not support the effort parameter (e.g. Haiku 4.5).
EXTRACTION_EFFORT=low

# Whether the model reasons before answering: disabled | adaptive
# Measured: leaving it on cost ~0.5s per label and changed no extracted field.
EXTRACTION_THINKING=disabled

# Re-read the label once when the government warning's wording does not match,
# before reporting a violation. Costs an extra call only on the mismatch path,
# and converts a rare transcription slip into "review" instead of a false
# rejection. Set to false to report the first reading as final.
CONFIRM_DISPUTED_WARNING=true

# Longest image edge sent to the API, in pixels. 2576 is the model's native
# ceiling. Lowering it cuts input tokens but barely moved latency in testing,
# and risks the fine print this tool exists to read.
MAX_IMAGE_EDGE=2576

# Model tried once if the primary declines a request. Defaults to a model
# different from ANTHROPIC_MODEL, since retrying the same one is pointless.
# ANTHROPIC_FALLBACK_MODEL=claude-opus-5

# Max labels processed in parallel during a batch run.
BATCH_CONCURRENCY=6

PORT=3001
